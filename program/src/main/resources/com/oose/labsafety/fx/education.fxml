<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.oose.labsafety.fx.EducationFxController">
    <Label text="안전교육 관리" styleClass="section-title" />
    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab text="이수기준 설정 등록">
            <VBox spacing="10" styleClass="panel">
                <GridPane hgap="8" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="18" />
                        <ColumnConstraints percentWidth="32" />
                        <ColumnConstraints percentWidth="18" />
                        <ColumnConstraints percentWidth="32" />
                    </columnConstraints>
                    <Label text="분류 ID" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                    <TextField fx:id="categoryIdField" promptText="RC004" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                    <Label text="분류명" GridPane.rowIndex="0" GridPane.columnIndex="2" />
                    <TextField fx:id="categoryNameField" promptText="실습생" GridPane.rowIndex="0" GridPane.columnIndex="3" />
                    <Label text="분류 설명" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                    <TextField fx:id="categoryDescriptionField" promptText="실습 참여 학생" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                    <Label text="사용 여부" GridPane.rowIndex="1" GridPane.columnIndex="2" />
                    <TextField fx:id="categoryActiveField" promptText="Y" GridPane.rowIndex="1" GridPane.columnIndex="3" />
                    <Label text="이수기준 ID" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                    <TextField fx:id="standardIdField" promptText="CS004" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                    <Label text="필수 이수시간" GridPane.rowIndex="2" GridPane.columnIndex="2" />
                    <TextField fx:id="requiredHoursField" promptText="3" GridPane.rowIndex="2" GridPane.columnIndex="3" />
                    <Label text="시작일" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                    <TextField fx:id="standardStartDateField" promptText="2026-01-01" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                    <Label text="종료일" GridPane.rowIndex="3" GridPane.columnIndex="2" />
                    <TextField fx:id="standardEndDateField" promptText="2026-12-31" GridPane.rowIndex="3" GridPane.columnIndex="3" />
                </GridPane>
                <Button text="등록" onAction="#registerResearcherStandard" />
                <TextArea fx:id="standardOutputArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS" />
            </VBox>
        </Tab>
        <Tab text="이수기준 설정 조회">
            <VBox spacing="10" styleClass="panel">
                <GridPane hgap="8" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="18" />
                        <ColumnConstraints percentWidth="62" />
                        <ColumnConstraints percentWidth="20" />
                    </columnConstraints>
                    <Label text="검색어" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                    <TextField fx:id="standardSearchField" promptText="전체 조회는 비워두세요" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                    <Button text="조회" onAction="#searchResearcherStandard" GridPane.rowIndex="0" GridPane.columnIndex="2" />
                </GridPane>
                <TextArea fx:id="standardSearchOutputArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS" />
            </VBox>
        </Tab>
        <Tab text="교육이수 결과 등록">
            <VBox spacing="10" styleClass="panel">
                <GridPane hgap="8" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="18" />
                        <ColumnConstraints percentWidth="32" />
                        <ColumnConstraints percentWidth="18" />
                        <ColumnConstraints percentWidth="32" />
                    </columnConstraints>
                    <Label text="이수결과 ID" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                    <TextField fx:id="completionIdField" promptText="ECR005" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                    <Label text="연구활동종사자 ID" GridPane.rowIndex="0" GridPane.columnIndex="2" />
                    <TextField fx:id="researcherIdField" promptText="user001" GridPane.rowIndex="0" GridPane.columnIndex="3" />
                    <Label text="교육개설정보 ID" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                    <TextField fx:id="openingIdField" promptText="EO003" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                    <Label text="이수일" GridPane.rowIndex="1" GridPane.columnIndex="2" />
                    <TextField fx:id="completionDateField" promptText="2026-04-10" GridPane.rowIndex="1" GridPane.columnIndex="3" />
                    <Label text="학습결과 ID" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                    <TextField fx:id="learningResultIdField" promptText="N/A" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                    <Label text="교육일지 ID" GridPane.rowIndex="2" GridPane.columnIndex="2" />
                    <TextField fx:id="logIdField" promptText="N/A" GridPane.rowIndex="2" GridPane.columnIndex="3" />
                    <Label text="인정시간" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                    <TextField fx:id="recognizedHoursField" promptText="3" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                    <Label text="이수 상태" GridPane.rowIndex="3" GridPane.columnIndex="2" />
                    <TextField fx:id="completionStatusField" promptText="이수" GridPane.rowIndex="3" GridPane.columnIndex="3" />
                </GridPane>
                <GridPane hgap="8">
                    <Button text="교육개설정보 불러오기" onAction="#loadEducationOpenings" GridPane.columnIndex="0" />
                    <Button text="등록" onAction="#registerCompletionResult" GridPane.columnIndex="1" />
                </GridPane>
                <TextArea fx:id="completionOutputArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS" />
            </VBox>
        </Tab>
        <Tab text="교육이수 내역 조회">
            <VBox spacing="10" styleClass="panel">
                <GridPane hgap="8" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="18" />
                        <ColumnConstraints percentWidth="42" />
                        <ColumnConstraints percentWidth="20" />
                        <ColumnConstraints percentWidth="20" />
                    </columnConstraints>
                    <Label text="검색어" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                    <TextField fx:id="historySearchField" promptText="전체 조회는 비워두세요" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                    <Button text="조회" onAction="#searchCompletionHistory" GridPane.rowIndex="0" GridPane.columnIndex="2" />
                    <TextField fx:id="historyDetailIdField" promptText="ECR005" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                    <Button text="상세 조회" onAction="#showCompletionDetail" GridPane.rowIndex="1" GridPane.columnIndex="2" />
                </GridPane>
                <TextArea fx:id="historyOutputArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS" />
            </VBox>
        </Tab>
    </TabPane>
    <padding>
        <Insets top="4" right="4" bottom="4" left="4" />
    </padding>
</VBox>
